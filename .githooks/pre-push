#!/bin/sh

set -e

cd "$(git rev-parse --show-toplevel)"

MAIN_TEX="Informe2/main.tex"
OUT_DIR="Informe2"

[ -f "$MAIN_TEX" ] || exit 0

echo "Verificando compilacion del proyecto LaTeX..."

compile_ok=0

if command -v latexmk >/dev/null 2>&1; then
    latexmk -pdf -cd "$MAIN_TEX" -halt-on-error -interaction=nonstopmode >/dev/null 2>&1 && compile_ok=1
elif command -v pdflatex >/dev/null 2>&1; then
    cd "$OUT_DIR" && pdflatex -halt-on-error -interaction=nonstopmode main.tex >/dev/null 2>&1 && compile_ok=1
elif command -v xelatex >/dev/null 2>&1; then
    cd "$OUT_DIR" && xelatex -halt-on-error -interaction=nonstopmode main.tex >/dev/null 2>&1 && compile_ok=1
elif command -v lualatex >/dev/null 2>&1; then
    cd "$OUT_DIR" && lualatex -halt-on-error -interaction=nonstopmode main.tex >/dev/null 2>&1 && compile_ok=1
fi

if [ "$compile_ok" -eq 0 ]; then
    echo "ERROR: La compilacion de LaTeX fallo. Corrige los errores antes de hacer push."
    exit 1
fi

echo "Compilacion exitosa."
